---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const tspParagraphs = (d.theSmallPrint ?? '').split(/\n\s*\n/).filter(Boolean);
const paperParts = [d.paperAuthors, d.paperYear ? `(${d.paperYear})` : null, d.paperTitle, d.paperJournal].filter(Boolean);
const paperCitation = paperParts.join('. ') + (paperParts.length ? '.' : '');
const paperHref = d.paperDOI ? `https://doi.org/${d.paperDOI}` : (d.paperURL || null);
const hasPaperInfo = paperParts.length > 0 || !!paperHref;
const esLink = d.translationSlug ? `/es/articulos/${d.translationSlug}` : '/es';
---

<Layout title={d.title} description={d.deck} image={d.image}>
  <style>
    .nav-top { border-bottom: 1px solid #c8c3ba; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; height: 44px; background: #f8f6f1; }
    .nav-top a { font-size: 11px; color: #8a94a0; text-decoration: none; letter-spacing: 0.06em; text-transform: uppercase; }
    .nav-top a:hover { color: #0d7377; }
    .nav-lang { color: #0d7377 !important; border: 0.5px solid #0d7377; padding: 3px 10px; border-radius: 20px; }
    .masthead { padding: 1.5rem 2rem 1rem; text-align: center; border-bottom: 3px solid #1e2d3d; }
    .masthead-name { font-family: Georgia, serif; font-size: 42px; color: #1e2d3d; letter-spacing: -0.5px; line-height: 1; }
    .masthead-name span { color: #14919B; }
    .masthead-sub { font-size: 11px; color: #8a94a0; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 6px; }
    .article-header { border-bottom: 1px solid #c8c3ba; padding: 2.5rem 2rem 2rem; max-width: 780px; margin: 0 auto; }
    .article-kicker { font-size: 10px; color: #0d7377; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.75rem; display: flex; gap: 12px; align-items: center; }
    .article-kicker-sep { color: #c8c3ba; }
    .article-h1 { font-family: Georgia, serif; font-size: 36px; color: #1e2d3d; line-height: 1.2; margin-bottom: 1rem; font-weight: normal; }
    .article-deck { font-size: 17px; color: #5a6472; line-height: 1.65; margin-bottom: 1.25rem; }
    .article-figure { margin: 0 0 1.5rem; }
    .article-figure img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; border: 0.5px solid #c8c3ba; }
    .article-figure figcaption { font-size: 12px; color: #8a94a0; line-height: 1.5; margin-top: 0.5rem; }
    .article-byline { font-size: 12px; color: #8a94a0; display: flex; gap: 16px; }
    .article-body { max-width: 680px; margin: 0 auto; padding: 2.5rem 2rem; }
    .article-body :global(h2) { font-family: Georgia, serif; font-size: 26px; color: #0d7377; margin-bottom: 0.85rem; margin-top: 2.75rem; padding-top: 2rem; border-top: 1px solid #e8e4db; font-weight: normal; line-height: 1.25; }
    .article-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
    .article-body :global(h3) { font-family: Georgia, serif; font-size: 19px; color: #1e2d3d; margin-top: 1.85rem; margin-bottom: 0.5rem; font-weight: 500; line-height: 1.3; }
    .article-body :global(p) { font-size: 16px; color: #5a6472; line-height: 1.8; margin-bottom: 1.25rem; }
    .article-body :global(strong) { color: #1e2d3d; font-weight: 500; }
    .paper-citation { border: 0.5px solid #c8c3ba; padding: 1rem 1.25rem; margin: 2rem 0; background: #fff; }
    .paper-citation-label { font-size: 10px; color: #8a94a0; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.5rem; }
    .paper-citation-text { font-size: 13px; color: #5a6472; line-height: 1.6; }
    .paper-citation-text a { color: #0d7377; text-decoration: none; margin-left: 4px; }
    .paper-citation-text a:hover { text-decoration: underline; }
    .tsp-section { background: #1e2d3d; padding: 2.5rem 2rem; margin-top: 1rem; }
    .tsp-section-inner { max-width: 680px; margin: 0 auto; }
    .tsp-label { font-size: 10px; color: #14919B; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.5rem; }
    .tsp-title { font-family: Georgia, serif; font-size: 22px; color: #fff; margin-bottom: 1.5rem; font-weight: normal; }
    .tsp-prose { font-size: 15px; color: #a0aab4; line-height: 1.8; }
    .tsp-prose p { margin-bottom: 1.1rem; }
    .tsp-prose p:last-child { margin-bottom: 0; }
    .footer { padding: 1.5rem 2rem; border-top: 1px solid #c8c3ba; display: flex; justify-content: space-between; align-items: center; background: #f8f6f1; }
    .footer-logo { font-family: Georgia, serif; font-size: 16px; color: #1e2d3d; }
    .footer-logo span { color: #14919B; }
    .footer-links a { font-size: 11px; color: #8a94a0; text-decoration: none; margin-left: 16px; }
    .footer-note { font-size: 11px; color: #8a94a0; }

    @media (max-width: 720px) {
      .nav-top { flex-wrap: wrap; height: auto; padding: 0.75rem 1.25rem; row-gap: 8px; }
      .nav-top > div { flex-wrap: wrap; gap: 10px 16px; }
      .footer { flex-direction: column; align-items: flex-start; gap: 10px; padding: 1.25rem; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 6px 14px; }
      .footer-links a { margin-left: 0; }
    }

    .article-actions { display: flex; gap: 10px; margin-top: 1rem; }
    .action-btn { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #1e2d3d; background: #fff; border: 0.5px solid #c8c3ba; padding: 6px 14px; cursor: pointer; letter-spacing: 0.04em; font-family: Inter, system-ui, sans-serif; }
    .action-btn:hover { border-color: #0d7377; color: #0d7377; }
    .action-btn i { font-size: 14px; }
    .share-toast { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%); background: #1e2d3d; color: #fff; font-size: 13px; padding: 10px 20px; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
    .share-toast.visible { opacity: 1; }
    .license-note { font-size: 12px; color: #8a94a0; line-height: 1.6; border-top: 0.5px solid #e8e4db; padding-top: 1rem; margin-top: 2rem; }
    .license-note a { color: #0d7377; text-decoration: none; }

    @media print {
    .nav-top, .masthead, .article-actions, .pdf-footer-web { display: none !important; }
    .article-header { padding: 1rem 0; }
    .article-body { padding: 0; }
    .pdf-print-header { display: flex !important; }
    .tsp-section { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
    .pdf-print-header { display: none; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid #1e2d3d; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .pdf-print-logo { font-family: Georgia, serif; font-size: 24px; color: #1e2d3d; }
    .pdf-print-logo span { color: #14919B; }
    .pdf-print-meta { font-size: 10px; color: #8a94a0; text-align: right; letter-spacing: 0.08em; text-transform: uppercase; }
    .pdf-only-header { display: none; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid #1e2d3d; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .pdf-only-logo { font-family: Georgia, serif; font-size: 24px; color: #1e2d3d; }
    .pdf-only-logo span { color: #14919B; }
    .pdf-only-meta { font-size: 10px; color: #8a94a0; text-align: right; letter-spacing: 0.08em; text-transform: uppercase; }
    .pdf-only-title-block { display: none; padding-bottom: 1.5rem; border-bottom: 1px solid #c8c3ba; margin-bottom: 1.5rem; }
    .pdf-only-kicker { font-size: 9px; color: #0d7377; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.5rem; }
    .pdf-only-h1 { font-family: Georgia, serif; font-size: 26px; color: #1e2d3d; line-height: 1.2; margin-bottom: 0.6rem; font-weight: normal; }
    .pdf-only-deck { font-size: 13px; color: #5a6472; line-height: 1.65; border-left: 2px solid #0d7377; padding-left: 10px; margin-bottom: 0.75rem; font-style: italic; }
    .pdf-only-byline { font-size: 10px; color: #8a94a0; }
    .pdf-only-tsp { display: none; background: #f0f4f4; border-left: 3px solid #0d7377; padding: 1.25rem 1.5rem; margin-top: 1.5rem; }
    .pdf-only-tsp-label { font-size: 9px; color: #0d7377; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.4rem; }
    .pdf-only-tsp-title { font-family: Georgia, serif; font-size: 16px; color: #1e2d3d; margin-bottom: 1rem; font-weight: normal; }
    .pdf-only-tsp-prose { font-size: 11px; color: #5a6472; line-height: 1.7; }
    .pdf-only-tsp-prose p { margin-bottom: 0.6rem; }
    .pdf-only-tsp-prose p:last-child { margin-bottom: 0; }

  </style>

  <div class="nav-top">
    <div style="display:flex; gap:20px;">
      <a href="/">← All articles</a>
      <a href="/about-tsp">About</a>
      <a href="/about">Meet the author</a>
    </div>
    <a href={esLink} class="nav-lang">En español</a>
  </div>

  <div class="masthead">
    <div class="masthead-name">The Small <span>Print</span></div>
    <div class="masthead-sub">From the study to you · {d.issue} · {d.date}</div>
  </div>

  <div class="article-header">
    <div class="article-kicker">
      <span>{d.topic}</span>
      <span class="article-kicker-sep">·</span>
      <span>{d.issue}</span>
      <span class="article-kicker-sep">·</span>
      <span>{d.readTime} read</span>
    </div>
    <h1 class="article-h1">{d.title}</h1>
    <p class="article-deck">{d.deck}</p>
    {d.image && (
      <figure class="article-figure">
        <img src={d.image} alt={d.imageAlt || d.title} />
        {d.imageAlt && <figcaption>{d.imageAlt}</figcaption>}
      </figure>
    )}
    <div class="article-byline">
    <span>By Diana Chiang Jurado</span>
     <span>·</span>
     <span>{d.date}</span>
    </div>
    <div class="article-actions">
     <button class="action-btn" id="btn-pdf">
        <i class="ti ti-download" aria-hidden="true"></i> Download PDF
     </button>
     <button class="action-btn" id="btn-share">
        <i class="ti ti-share" aria-hidden="true"></i> Share
     </button>
    </div>
  </div>

<div id="article-content">
  <div class="pdf-only-header">
    <div class="pdf-only-logo">The Small <span>Print</span></div>
    <div class="pdf-only-meta">{d.issue} · {d.date} · thesmallprint.pub</div>
  </div>
  <div class="pdf-only-title-block">
    <div class="pdf-only-kicker">{d.topic} · {d.issue} · {d.readTime} read</div>
    <h1 class="pdf-only-h1">{d.title}</h1>
    <p class="pdf-only-deck">{d.deck}</p>
    <div class="pdf-only-byline">By Diana Chiang Jurado · {d.date}</div>
  </div>
  <div class="article-body">
    <Content />
    {hasPaperInfo && (
      <div class="paper-citation">
        <div class="paper-citation-label">Original paper</div>
        <p class="paper-citation-text">
          {paperCitation}
          {paperHref && <a href={paperHref} target="_blank" rel="noopener">{paperHref}</a>}
        </p>
      </div>
    )}
    <div class="license-note">
      <i class="ti ti-creative-commons" aria-hidden="true"></i>
      This article is published under a <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank">Creative Commons CC BY 4.0</a> license. You are free to share and adapt this content for any purpose, as long as you credit the original author: Diana Chiang Jurado / The Small Print.
    </div>
  </div>
  <div class="pdf-only-tsp">
    <div class="pdf-only-tsp-label">The Small Print §</div>
    <div class="pdf-only-tsp-title">What the headlines will probably get wrong</div>
    <div class="pdf-only-tsp-prose">
      {tspParagraphs.map(p => <p>{p}</p>)}
    </div>
  </div>
</div>

<script define:vars={{ shareTitle: d.title, shareText: d.deck, pdfSlug: article.id }}>
  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('btn-pdf').addEventListener('click', function() {
      window.location.href = '/articles/' + pdfSlug + '-pdf';
    });

    function showToast(message) {
      const toast = document.getElementById('share-toast');
      toast.textContent = message;
      toast.classList.add('visible');
      setTimeout(() => toast.classList.remove('visible'), 2500);
    }

    document.getElementById('btn-share').addEventListener('click', async function() {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: shareTitle, text: shareText, url });
        } catch (err) {
          // user cancelled the share sheet — nothing to do
        }
        return;
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        try {
          await navigator.clipboard.writeText(url);
          showToast('Link copied to clipboard');
          return;
        } catch (err) {
          // fall through to the prompt fallback below
        }
      }
      // Share/Clipboard APIs need a secure (https) context — this covers
      // browsers or connections where neither is available.
      window.prompt('Copy this link:', url);
    });
  });
</script>

  <div class="tsp-section">
    <div class="tsp-section-inner">
      <div class="tsp-label">The Small Print §</div>
      <h2 class="tsp-title">What the headlines will probably get wrong</h2>
      <div class="tsp-prose">
        {tspParagraphs.map(p => <p>{p}</p>)}
      </div>
    </div>
  </div>

  <div class="footer">
    <div class="footer-logo">The Small <span>Print</span></div>
    <div class="footer-links">
      <a href="/about-tsp">About</a>
      <a href="/about">Author</a>
      <a href="mailto:dianachj@thesmallprint.pub">Contact</a>
      <a href={esLink}>En español</a>
    </div>
    <div class="footer-note">Independent · Bilingual · Freiburg</div>
  </div>
  <div class="share-toast" id="share-toast">Link copied to clipboard</div>
</Layout>